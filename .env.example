# ForgeHub frontend — environment.
#
# Copy to `.env.local` (which is git-ignored) for local development:
#
#   cp .env.example .env.local
#
# Every value here is a public, non-secret URL. Anything prefixed
# `NEXT_PUBLIC_` is inlined into the browser bundle, so no credential may ever
# be stored in this file.
#
# ── Build time, not run time ─────────────────────────────────────────────
# `NEXT_PUBLIC_*` values are baked in when `next build` runs. Setting them
# only in the runtime environment has no effect on the compiled bundle, so a
# production deployment must set them for the BUILD.
#
# A production build with either variable unset, non-absolute, or pointing at
# localhost is refused — see `src/lib/env-contract.ts`. In development the
# localhost defaults below apply automatically, so a fresh clone runs with no
# `.env.local` at all.

# Where the backend API is mounted. Must include the `/api/v1` prefix.
# Matches the backend's own defaults (backend/.env.example: PORT=4000).
# Production: https://api.your-domain/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.IO origin — the server ROOT, without the API prefix. Socket.IO mounts
# its own `/socket.io` path, so pointing this at NEXT_PUBLIC_API_URL would
# produce `/api/v1/socket.io` and fail the handshake.
# Production: https://api.your-domain
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
