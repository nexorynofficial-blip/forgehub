# ForgeHub frontend — local environment.
#
# Copy to `.env.local` (which is git-ignored) and adjust if your backend runs
# somewhere other than the default. Every value here is a public, non-secret
# URL: anything prefixed `NEXT_PUBLIC_` is inlined into the browser bundle, so
# no credential may ever be stored in this file.
#
#   cp .env.example .env.local

# Where the backend API is mounted. Must include the `/api/v1` prefix.
# Matches the backend's own defaults (backend/.env.example: PORT=4000).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Socket.IO origin — the server root, without the API prefix.
# Not used yet: realtime arrives in Integration Phase 6.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
