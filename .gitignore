# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors / IDEs
.vscode/
.idea/
*.swp
*~

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# NOTE: this matches at every depth, including backend/. `backend/.gitignore`
# re-includes `backend/.env.example` with a negation so the template stays
# committable while every real `.env` remains ignored.
.env*
# Same reasoning for the frontend's own template: `.env.example` documents the
# `NEXT_PUBLIC_*` URLs and holds no secret, so it is committed while
# `.env.local` and every other real env file stay ignored.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
