# ForgeHub backend — environment template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Never commit real secrets.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins (the Next.js frontend).
CORS_ORIGIN=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────────────────────────
# Published on 5433 rather than the default 5432 to avoid colliding with any
# other Postgres already running on the host. Only the *host* port changes —
# inside the compose network the container still listens on 5432, which is
# why the backend service's DATABASE_URL uses `postgres:5432`.
DATABASE_URL=postgresql://forgehub:forgehub_dev_password@localhost:5433/forgehub?schema=public

# Used by docker-compose to provision the Postgres container.
POSTGRES_USER=forgehub
POSTGRES_PASSWORD=forgehub_dev_password
POSTGRES_DB=forgehub
POSTGRES_PORT=5433

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ── Logging ──────────────────────────────────────────────────────────────
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── JWT & tokens ─────────────────────────────────────────────────────────
# Both are required and must be at least 32 characters.
# Generate with:  openssl rand -base64 48
#
# The `replace_me_...` values below are REJECTED at boot on purpose. Copying
# this file and running the server will fail fast and name the variables that
# still need real values — a long placeholder would otherwise pass the length
# check and leave you signing tokens with a key published in this repository.
#
# JWT_ACCESS_SECRET  signs short-lived access tokens (HS256).
# JWT_REFRESH_SECRET does NOT sign anything — refresh tokens are opaque, not
#                    JWTs. It is the HMAC key that peppers every stored token
#                    hash, so a database dump alone cannot verify guesses.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Applied instead of JWT_REFRESH_EXPIRES when "Remember me" is ticked.
JWT_REFRESH_REMEMBER_EXPIRES=30d

# ── Two-factor authentication ────────────────────────────────────────────
# Required, min 32 chars. AES-256-GCM key material for TOTP secrets at rest.
# There is deliberately no default — a shipped encryption key protects nothing,
# and the placeholder below is rejected at boot for exactly the same reason.
# Generate with:  openssl rand -base64 48
TWO_FACTOR_SECRET_KEY=replace_me_with_another_long_random_string_32
# Shown as the account issuer inside authenticator apps.
TOTP_ISSUER=ForgeHub
# How long a password-verified but 2FA-incomplete login stays resumable.
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300

# ── Cookies ──────────────────────────────────────────────────────────────
# The refresh token is transported ONLY as an httpOnly cookie, never in JSON.
REFRESH_COOKIE_NAME=forgehub_refresh
TWO_FACTOR_COOKIE_NAME=forgehub_2fa
# Scoped so the credential is not attached to every ordinary API request.
AUTH_COOKIE_PATH=/api/v1/auth
# lax | strict | none  ("none" additionally requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Defaults to true in production and false elsewhere; set to override.
# COOKIE_SECURE=false
# COOKIE_DOMAIN=

# ── Email ────────────────────────────────────────────────────────────────
# Only the development console transport exists so far — it prints messages to
# stdout instead of sending them. A real provider is a later phase.
EMAIL_PROVIDER=console
EMAIL_FROM=ForgeHub <no-reply@forgehub.dev>
# Public frontend origin, used to build verification and reset links.
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRES=24h
PASSWORD_RESET_EXPIRES=1h

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Tighter budget for the credential endpoints, per source address.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# ── Brute-force lockout ──────────────────────────────────────────────────
# A separate mechanism from rate limiting: this locks an *identifier* (an
# email, a user id) across all sources, defeating distributed credential
# stuffing that a per-IP limit would miss. Lock time doubles per failure.
AUTH_BRUTE_FORCE_MAX_ATTEMPTS=5
AUTH_BRUTE_FORCE_WINDOW_SECONDS=900
AUTH_BRUTE_FORCE_BASE_LOCK_SECONDS=60
AUTH_BRUTE_FORCE_MAX_LOCK_SECONDS=3600

# ── Limits & shutdown ────────────────────────────────────────────────────
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# ── Deferred integrations ────────────────────────────────────────────────
# Declared here for completeness (BACKEND_ARCHITECTURE.md §32) but NOT yet
# read by the env schema — adding them to validation now would force every
# developer to supply credentials for services no phase uses yet. Each is
# promoted into `src/config/env.ts` by the phase that introduces it.

# File storage — uploads phase
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Real transactional email provider — a later phase
# EMAIL_API_KEY=

# AI provider — AI phase (kept provider-agnostic per TRD §27)
# AI_PROVIDER=
# AI_API_KEY=
